{
  "manifest_version": 3,
  "name": "Host Terminal",
  "version": "0.2.0",
  "description": "Real local shell sessions inside Chrome. Tabs, splits, profiles and native PTYs through an explicitly installed companion.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "sidePanel",
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Host Terminal",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "terminal.html"
  },
  "commands": {
    "open-terminal": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open Host Terminal"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open terminal side panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; frame-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
}
